{
  "name": "tomz-boost",
  "productName": "Tomz Boost",
  "version": "1.0.2",
  "private": true,
  "description": "Utilidad de sistema y optimizacion para Windows (monitoreo real + tweaks reales).",
  "author": "Tomz Boost",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:local": "node scripts/dev.cjs --key on",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "dist": "electron-vite build && electron-builder --win",
    "dist:flow": "node scripts/dist-flow.cjs",
    "key:new": "node scripts/generate-key.cjs",
    "start:bot": "node scripts/discord-key-bot.cjs",
    "bot": "node scripts/discord-key-bot.cjs",
    "icon": "node scripts/generate-icon.cjs",
    "test:nvidia-profile-migration": "node scripts/test-nvidia-profile-migration.cjs",
    "test:registry-toggle-backup": "node scripts/test-registry-toggle-backup.cjs",
    "test:retire-legacy-tweaks": "node scripts/test-retire-legacy-tweaks.cjs",
    "test:service-starttype-parse": "node scripts/test-service-starttype-parse.cjs",
    "test:cold-boot-reg-reads": "node scripts/test-cold-boot-reg-reads.cjs",
    "test:mp-qr-png": "node scripts/test-mp-qr-png.cjs"
  },
  "build": {
    "appId": "com.tomzboost.app",
    "productName": "Tomz Boost",
    "copyright": "Copyright © Tomz Boost",
    "artifactName": "Tomz-Boost-Setup-${version}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Tomz Boost"
    },
    "nsis": {
      "shortcutName": "Tomz Boost",
      "uninstallDisplayName": "Tomz Boost",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "discord-rpc": "^4.0.1",
    "qrcode": "^1.5.4",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@types/discord-rpc": "^4.0.11",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "discord.js": "^14.27.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
